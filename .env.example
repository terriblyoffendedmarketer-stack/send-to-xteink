# Authentication credentials for the upload page and OPDS feed.
# CrossPoint supports HTTP Basic auth — use these same credentials
# when adding the OPDS server on your XTEink device.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Vercel Blob storage token.
# Create a Blob store in your Vercel project dashboard, then copy the token.
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=
