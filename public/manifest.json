{
  "name": "Send to XTEink",
  "short_name": "XTEink",
  "description": "Upload EPUBs from anywhere. Download on your XTEink e-reader.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#fafafa",
  "theme_color": "#171717",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [".epub", ".pdf", ".cbz", ".cbr", ".fb2", ".mobi", ".azw3", ".txt", "application/epub+zip", "application/pdf", "application/octet-stream"]
        }
      ]
    }
  }
}
